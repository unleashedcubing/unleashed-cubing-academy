rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isChatMember(chatId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
    }

    function validDirectChat() {
      return request.resource.data.type == 'dm'
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2
        && request.auth.uid in request.resource.data.memberIds;
    }

    // User profile + sessions — owner only
    match /users/{uid}/data/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/friends/{friendUid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Either member can create/remove their matching entry. The app only makes
      // this reciprocal write after a request is accepted.
      allow create: if request.auth != null
        && request.resource.data.uid == friendUid
        && (request.auth.uid == uid || request.auth.uid == friendUid);
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null
        && (request.auth.uid == uid || request.auth.uid == friendUid);
    }

    match /socialUsers/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.toUid == request.auth.uid;
    }

    match /battleInvites/{inviteId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid;
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /chats/{chatId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && validDirectChat();
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds == resource.data.memberIds;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.authorUid == request.auth.uid;
      }

      match /calls/{callId} {
        allow read: if isChatMember(chatId);
        allow create, update: if isChatMember(chatId);

        match /{candidateCollection}/{candidateId} {
          allow read, create: if isChatMember(chatId)
            && candidateCollection in ['offerCandidates', 'answerCandidates'];
        }
      }
    }

    // Battles — any signed-in user can participate.
    // Client-side gate (bypass code / 150 solves) controls who can reach the UI.
    match /battles/{code} {
      allow read, create, update: if request.auth != null;

      match /players/{uid} {
        allow read:                    if request.auth != null;
        allow create, update, delete:  if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
