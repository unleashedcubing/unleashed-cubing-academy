rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile + sessions — owner only
    match /users/{uid}/data/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/friends/{friendUid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Either member can create/remove their matching entry. The app only makes
      // this reciprocal write after a request is accepted.
      allow create: if request.auth != null
        && request.resource.data.uid == friendUid
        && (request.auth.uid == uid || request.auth.uid == friendUid);
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null
        && (request.auth.uid == uid || request.auth.uid == friendUid);
    }

    match /socialUsers/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.toUid == request.auth.uid;
    }

    match /battleInvites/{inviteId} {
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /chats/{chatId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds
          && request.resource.data.authorUid == request.auth.uid;
      }

      match /calls/{callId} {
        allow read, create, update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;

        match /{candidateCollection}/{candidateId} {
          allow read, create: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        }
      }
    }

    // Battles — any signed-in user can participate.
    // Client-side gate (bypass code / 150 solves) controls who can reach the UI.
    match /battles/{code} {
      allow read, create, update: if request.auth != null;

      match /players/{uid} {
        allow read:                    if request.auth != null;
        allow create, update, delete:  if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
